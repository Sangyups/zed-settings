// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-1": "project_panel::ToggleFocus",
      "alt-f12": "terminal_panel::ToggleFocus",
    },
  },
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space e f": "project_panel::ToggleFocus",
      "space f w": "pane::DeploySearch",
      "space e e": "project_panel::ToggleFocus",
      "cmd-1": "project_panel::ToggleFocus",
      "alt-f12": "terminal_panel::ToggleFocus",
    },
  },
  {
    "context": "ProjectPanel && !editing",
    "bindings": {
      "space e f": "workspace::ToggleLeftDock",
      "space e e": "workspace::ToggleLeftDock",
      "escape": "workspace::ToggleLeftDock",
      "cmd-1": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "AssistantPanel",
    "bindings": {
      "escape": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "DebugPanel",
    "bindings": {
      "escape": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "cmd-?": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-f12": "terminal_panel::ToggleFocus",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-f12": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "vim_mode",
    "bindings": {
      "ctrl-q": "editor::ShowSignatureHelp",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
      "n": ["workspace::SendKeystrokes", "n z z"],
      "N": ["workspace::SendKeystrokes", "N z z"],
      "g o": "vim::StartOfDocument",
      "∆": "editor::MoveLineDown",
      "˚": "editor::MoveLineUp",
      "space r n": "editor::Rename",
      "space c a": "editor::ToggleCodeActions",
      "space f m": "editor::Format",
      "space a e": "assistant::InlineAssist",
    },
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "˙": "pane::ActivatePreviousItem",
      "¬": "pane::ActivateNextItem",
      "space d": "editor::Hover",
      "space g h p": "editor::ToggleSelectedDiffHunks",
      "space g h r": "git::Restore",
      "space g h a": "git::StageAndNext",
      "space g h u": "git::UnstageAndNext",
      "space g h s": "git::ToggleStaged",
      "space g b": "editor::OpenGitBlameCommit",
      "g c c": "editor::ToggleComments",
      "g r": "editor::FindAllReferences",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDeclaration",
      "g i": "editor::GoToImplementation",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "space e f": "pane::RevealInProjectPanel",
      "space e e": "project_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "space f w": "pane::DeploySearch",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] d": "editor::GoToDiagnostic",
      "[ g": "editor::GoToPreviousHunk",
      "] g": "editor::GoToHunk",
      "ctrl-a": "editor::SelectAll",
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "] f": "vim::NextMethodStart",
      "] shift-f": "vim::NextMethodEnd",
      "[ f": "vim::PreviousMethodStart",
      "[ shift-f": "vim::PreviousMethodEnd",
      "space b p": "editor::ToggleBreakpoint",
      "space b d a": ["pane::CloseOtherItems", { "close_pinned": false }],
    },
  },
  {
    "context": "vim_operator == d",
    "bindings": {
      "s": "vim::PushDeleteSurrounds",
    },
  },
  {
    "context": "vim_operator == c",
    "bindings": {
      "s": ["vim::PushChangeSurrounds", {}],
    },
  },
  {
    "context": "vim_operator == y",
    "bindings": {
      "s": ["vim::PushAddSurrounds", {}],
    },
  },
  {
    "context": "Workspace && !Terminal",
    "bindings": {
      "ctrl-shift-r": "task::Spawn",
      "ctrl-shift-d": "debugger::Start",
    },
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "g c": "editor::ToggleComments",
      "shift-s": "vim::PushAddSurrounds",
      ">": "editor::Indent",
      "<": "editor::Outdent",
    },
  },
  {
    "context": "Editor && (edit_prediction || edit_prediction_conflict)",
    "bindings": {
      "ctrl-y": "editor::AcceptEditPrediction",
      "tab": "editor::Tab",
    },
  },
]
