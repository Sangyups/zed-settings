// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "ProjectPanel",
    "bindings": {
      "space e f": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Editor || Terminal",
    "bindings": {
      "alt-f12": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "escape": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "(vim_mode == normal || vim_mode == visual) && vim_mode != waiting",
    "bindings": {
      // put key-bindings here if you want them to work in normal & visual mode
      "ctrl-a": "editor::SelectAll",
      "∆": "editor::MoveLineDown",
      "˚": "editor::MoveLineUp",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] d": "editor::GoToDiagnostic",
      "space d": "editor::Hover",
      "[ h": "editor::GoToPreviousHunk",
      "] h": "editor::GoToHunk",
      "space g h p": "editor::ToggleSelectedDiffHunks",
      "space g h r": "git::Restore",
      "space e f": "workspace::ToggleLeftDock",
      "space f f": "file_finder::Toggle",
      "space r n": "editor::Rename",
      "space c a": "editor::ToggleCodeActions"
    }
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "˙": "pane::ActivatePreviousItem",
      "¬": "pane::ActivateNextItem",
      "g c c": "editor::ToggleComments",
      "g r": "editor::FindAllReferences",
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDeclaration",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-q": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "Editor && edit_prediction && !showing_completions",
    "bindings": {
      "alt-enter": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "vim_mode == visual && !menu",
    "bindings": {
      "g c": "editor::ToggleComments",
      ">": "editor::Indent",
      "<": "editor::Outdent"
    }
  }
]
