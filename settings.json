{
  "assistant": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "o3-mini"
    },
    "version": "2"
  },
  "terminal": {
    "dock": "bottom",
    "font_family": "Liga SFMono Nerd Font"
  },
  "theme": "Github Dark",
  "telemetry": {
    "metrics": false
  },
  "ui_font_size": 15,
  "buffer_font_size": 12,
  "cursor_blink": false,
  "buffer_font_family": "SF Mono",
  "buffer_font_fallbacks": ["D2Coding"],
  "format_on_save": "on",
  "relative_line_numbers": true,
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "on_yank"
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  }
}
